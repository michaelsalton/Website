---
import type { GetStaticPaths } from 'astro';
import Card from '../../components/ui/Card.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPosts } from '../../lib/content';
import { formatDate, slugify } from '../../lib/format';

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  // Group by slug rather than raw tag so "Web GL" and "web-gl" can't produce two pages
  // that collide on the same URL.
  const byTag = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugify(tag);
      const existing = byTag.get(slug);
      if (existing) {
        existing.posts.push(post);
      } else {
        byTag.set(slug, { label: tag, posts: [post] });
      }
    }
  }

  return [...byTag.entries()].map(([slug, { label, posts: tagged }]) => ({
    params: { tag: slug },
    props: { label, posts: tagged },
  }));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;
---

<PageLayout
  title={label}
  description={`Posts tagged ${label}.`}
  lede={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged “${label}”.`}
>
  <CardGrid label={`Posts tagged ${label}`}>
    {posts.map((post) => (
        <li>
          <Card
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            meta={formatDate(post.data.pubDate)}
            tags={post.data.tags}
          />
        </li>
      ))}
  </CardGrid>

  <p class="mt-10">
    <a href="/blog" class="text-accent hover:underline">&larr; All posts</a>
  </p>
</PageLayout>
