---
/**
 * Full-screen project modal. Rendered once per project; activated by any element
 * with `data-show-project="<project-id>"`. Clicking the backdrop or the X button
 * closes it. Body scroll is locked while open.
 */

import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import PillButton from './PillButton.astro';
import TextBlock from './TextBlock.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, stack, cover, coverAlt, repo, live, link } = project.data;
---

<div
  id={`show-${project.id}`}
  class="project-show-card fixed inset-0 z-50 hidden items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-label={title}
>
  {/* Backdrop */}
  <div class="absolute inset-0 bg-overlay" data-close-show></div>

  {/* Card */}
  <div
    class="relative z-10 m-5 h-[calc(100vh-2.5rem)] w-[calc(100vw-2.5rem)] overflow-y-auto overscroll-contain rounded-2xl bg-surface-raised shadow-[0_4px_12px_color-mix(in_oklab,var(--ink-900)_25%,transparent),0_24px_64px_color-mix(in_oklab,var(--ink-900)_20%,transparent)]"
    data-lenis-prevent
  >
    {/* Close button */}
    <button
      type="button"
      class="sticky right-4 top-4 z-20 ml-auto mr-4 mt-4 flex h-12 w-12 items-center justify-center rounded-full bg-surface-sunken text-content-muted transition-[colors,transform] duration-(--duration-fast) hover:scale-110 hover:text-content"
      data-close-show
      aria-label="Close"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M5 5l10 10M15 5L5 15"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    {/* Title + summary — centered header area */}
    <div class="flex flex-col items-center justify-center px-8 py-16 text-center sm:px-16 sm:py-20">
      <h2 class="text-h1 text-content">{title}</h2>
      <p class="mt-3 max-w-lg text-body-sm text-content-muted">{summary}</p>
    </div>

    {/* Content area */}
    <div class="px-6 pb-16 pt-8 sm:px-10 sm:pb-20 sm:pt-10">
      {/* Image grid — two side-by-side, one full-width below */}
      <div class="mx-auto grid max-w-4xl grid-cols-2 gap-4">
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="col-span-2 aspect-[4/3] w-full rounded-xl object-cover" widths={[640, 960, 1280]} sizes="(max-width: 1024px) 90vw, 60vw" />
        ) : (
          <div class="col-span-2 aspect-[4/3] rounded-xl bg-surface-sunken"></div>
        )}
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="aspect-square w-full rounded-xl object-cover" widths={[320, 480, 640]} sizes="(max-width: 1024px) 45vw, 30vw" />
        ) : (
          <div class="aspect-square rounded-xl bg-surface-sunken"></div>
        )}
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="aspect-square w-full rounded-xl object-cover" widths={[320, 480, 640]} sizes="(max-width: 1024px) 45vw, 30vw" />
        ) : (
          <div class="aspect-square rounded-xl bg-surface-sunken"></div>
        )}
      </div>

      <TextBlock class="mt-10">
        The process began with research into existing approaches, weighing the tradeoffs between
        accuracy and performance at scale. From there, the implementation evolved through several
        iterations — each one tightening the feedback loop between the data and the visual output
        until the result felt both technically sound and satisfying to interact with.
      </TextBlock>

      <div class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-4">
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="aspect-square w-full rounded-xl object-cover" widths={[320, 480, 640]} sizes="(max-width: 1024px) 45vw, 30vw" />
        ) : (
          <div class="aspect-square rounded-xl bg-surface-sunken"></div>
        )}
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="aspect-square w-full rounded-xl object-cover" widths={[320, 480, 640]} sizes="(max-width: 1024px) 45vw, 30vw" />
        ) : (
          <div class="aspect-square rounded-xl bg-surface-sunken"></div>
        )}
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="aspect-square w-full rounded-xl object-cover" widths={[320, 480, 640]} sizes="(max-width: 1024px) 45vw, 30vw" />
        ) : (
          <div class="aspect-square rounded-xl bg-surface-sunken"></div>
        )}
        {cover ? (
          <Image src={cover} alt={coverAlt ?? ''} class="aspect-square w-full rounded-xl object-cover" widths={[320, 480, 640]} sizes="(max-width: 1024px) 45vw, 30vw" />
        ) : (
          <div class="aspect-square rounded-xl bg-surface-sunken"></div>
        )}
      </div>

      {stack.length > 0 && (
        <ul class="mt-4 flex flex-wrap justify-center gap-1.5" aria-label="Stack">
          {stack.map((tag) => (
            <li class="rounded-md bg-surface-raised px-2 py-0.5 text-micro text-content-subtle">
              {tag}
            </li>
          ))}
        </ul>
      )}

      {(repo || live) && (
        <div class="mt-6 flex justify-center gap-4">
          {repo && (
            <Button href={repo} variant="press" rel="noopener" target="_blank">
              Source
            </Button>
          )}
          {live && (
            <Button href={live} variant="press" rel="noopener" target="_blank">
              Live
            </Button>
          )}
        </div>
      )}

      {/* Markdown body via slot */}
      <div class="prose prose-lg mt-8">
        <slot />
      </div>

      {link && (
        <div class="mt-10 flex justify-center">
          <PillButton href={link} target="_blank" rel="noopener">
            Go To Project
          </PillButton>
        </div>
      )}
    </div>
  </div>
</div>

<script>
/** Short soft tick sound via Web Audio for the close button. */
function playCloseTick() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = new AudioContext();
  if (ctx.state === 'suspended') ctx.resume();
  const t = ctx.currentTime;

  const gain = ctx.createGain();
  gain.gain.setValueAtTime(0, t);
  gain.gain.linearRampToValueAtTime(0.08, t + 0.005);
  gain.gain.exponentialRampToValueAtTime(0.001, t + 0.06);
  gain.connect(ctx.destination);

  const osc = ctx.createOscillator();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(800, t);
  osc.frequency.exponentialRampToValueAtTime(400, t + 0.04);
  osc.connect(gain);
  osc.start(t);
  osc.stop(t + 0.06);
}

function initShowCards() {
  const triggers = document.querySelectorAll<HTMLElement>('[data-show-project]');
  const modals = document.querySelectorAll<HTMLElement>('.project-show-card');

  function openModal(id: string) {
    const modal = document.getElementById(`show-${id}`);
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    (window as any).__lenis?.stop();

    const closeBtn = modal.querySelector<HTMLButtonElement>('button[data-close-show]');
    closeBtn?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    (window as any).__lenis?.start();
  }

  function closeAll() {
    for (const m of modals) closeModal(m);
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const id = trigger.getAttribute('data-show-project');
      if (id) openModal(id);
    });
  });

  modals.forEach((modal) => {
    modal.querySelectorAll('[data-close-show]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn instanceof HTMLButtonElement) playCloseTick();
        closeModal(modal);
      });
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
}

initShowCards();
document.addEventListener('astro:after-swap', initShowCards);
</script>
