---
import { SOCIALS } from '../../consts';
import SocialIcon from './SocialIcon.astro';

interface Props {
  class?: string;
  style?: string;
}

const { class: className, ...attrs } = Astro.props;
---

<div
  class:list={[
    'flex flex-col items-center gap-4',
    className,
  ]}
  {...attrs}
>
  <p class="text-caption text-content-subtle">Contact me</p>
  <ul class="inline-flex items-center gap-2" aria-label="Social links">
    {SOCIALS.map((s) => (
      <li>
        <SocialIcon href={s.href} label={s.label} />
      </li>
    ))}
  </ul>
</div>
