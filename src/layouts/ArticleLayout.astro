---
/** Long-form shell for blog posts and project write-ups. */
import Tag from '../components/ui/Tag.astro';
import { formatDate, isoDate } from '../lib/format';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  ogImage?: string;
  /** Small label above the title, e.g. "Project" or "Demo". */
  eyebrow?: string;
}

const {
  title,
  description,
  publishedTime,
  modifiedTime,
  tags = [],
  ogImage,
  eyebrow,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mb-10">
      {eyebrow && (
          <p class="mb-3 text-label uppercase text-highlight">
            {eyebrow}
          </p>
        )}

      <h1 class="text-h1 text-content">{title}</h1>

      <div
        class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-caption text-content-subtle"
      >
        {publishedTime && (
            <time datetime={isoDate(publishedTime)}>{formatDate(publishedTime)}</time>
          )}
        {modifiedTime && (
            <span>
              Updated <time datetime={isoDate(modifiedTime)}>{formatDate(modifiedTime)}</time>
            </span>
          )}
      </div>

      {tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <Tag tag={tag} />
              </li>
            ))}
          </ul>
        )}
    </header>

    <div class="prose prose-lg">
      <slot />
    </div>
  </article>
</BaseLayout>
