---
/**
 * Renders one ProjectShowCard modal per published project. Drop this component
 * into any page whose cards carry `data-show-project` attributes.
 */
import { render } from 'astro:content';
import { getProjects } from '../../lib/content';
import ProjectShowCard from './ProjectShowCard.astro';

const projects = await getProjects();

const rendered = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  }),
);
---

{rendered.map(({ project, Content }) => (
  <ProjectShowCard project={project}>
    <Content />
  </ProjectShowCard>
))}
