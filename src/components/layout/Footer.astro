---
import { SITE } from '../../consts';
import SocialLinkTextStack from '../ui/SocialLinkTextStack.astro';

const year = new Date().getFullYear();
---

<footer
  id="footer"
  class="on-inverse bg-surface-inverse min-h-screen flex flex-col items-center justify-end gap-8 py-8"
>
  <div class="flex flex-col items-center gap-4">
    <a
      href={`mailto:${SITE.email}`}
      class="text-body text-content-inverse hover:text-accent-soft transition-colors"
    >
      {SITE.email}
    </a>
    <SocialLinkTextStack />
  </div>
  <p class="text-center text-caption text-content-inverse-muted">&copy; {year} {SITE.title}.</p>
</footer>
