---
import HeroDots from '../components/ui/HeroDots.astro';
import HeroMainText from '../components/ui/HeroMainText.astro';
import HeroSubText from '../components/ui/HeroSubText.astro';
import SocialsTray from '../components/ui/SocialsTray.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout singlePage>
  <section
    id="hero"
    class="relative flex h-dvh flex-col items-center bg-surface-raised px-4 pt-4 pb-12 sm:px-6"
  >
    <HeroDots />
    {/* Name — centered in the dot region (top 50%) */}
    <div class="absolute inset-x-0 top-0 z-10 flex h-1/2 items-center justify-center px-4 sm:px-6">
      <HeroMainText />
    </div>

    {/* Sub text — starts at the halfway mark */}
    <div
      class="absolute inset-x-0 top-[40%] z-10 flex flex-col items-center gap-10 px-4 sm:gap-14 sm:px-6"
    >
      <HeroSubText />
    </div>

    {/* Socials — bottom-pinned */}
    <div class="mt-auto">
      <SocialsTray class="" />
    </div>
  </section>
</BaseLayout>
