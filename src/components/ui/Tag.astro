---
/**
 * Outlined tag pill linking to a tag's archive page.
 *
 * Extracted because the class string and the `/tags/${slugify(tag)}` href were
 * duplicated byte-for-byte in ArticleLayout and the blog index — so a colour change
 * silently landed in one of the two places.
 *
 * The border is `line-strong` rather than `line`: the pill is interactive, and an
 * interactive boundary is the affordance, so it owes the page 3:1.
 */
import { slugify } from '../../lib/format';

interface Props {
  tag: string;
  /** Post count, appended after the label. Index pages pass it; articles don't. */
  count?: number;
}

const { tag, count } = Astro.props;
---

<a
  href={`/tags/${slugify(tag)}`}
  class="inline-block rounded-full border border-line-strong px-3 py-1 text-micro text-content-muted transition-colors hover:border-highlight hover:text-highlight"
>
  {tag}
  {count !== undefined && <span class="text-content-subtle"> {count}</span>}
</a>
