# Normalize to LF in the repository. Without this, committing from Windows stores CRLF
# and the Ubuntu CI runner sees the whole tree as modified.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated: collapse in diffs and exclude from language stats.
package-lock.json -diff linguist-generated
