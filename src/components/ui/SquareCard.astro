---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** CSS colour value for the placeholder when no cover image is provided. */
  fill?: string;
  /** When set, clicking opens the ProjectShowCard modal instead of navigating. */
  showProject?: string;
}

const { href, title, cover, coverAlt, fill, showProject } = Astro.props;
---

<a
  href={href}
  class="work-thumb group mx-auto block max-w-80 overflow-hidden rounded-[10%] shadow-[0_4px_12px_color-mix(in_oklab,var(--ink-900)_15%,transparent),0_16px_48px_color-mix(in_oklab,var(--ink-900)_10%,transparent)] transition-transform duration-(--duration-base) ease-(--ease-out-soft) hover:-translate-y-0.5"
  {...showProject ? { 'data-show-project': showProject } : {}}
>
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? ''}
      class="w-full rounded-[10%] object-cover transition-transform duration-(--duration-base) ease-(--ease-out-soft)"
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
    />
  ) : (
    <div
      class="aspect-square w-full rounded-[10%] transition-transform duration-(--duration-base) ease-(--ease-out-soft)"
      style={fill ? `background-color: ${fill}` : undefined}
    >
      <span class="sr-only-focusable">{title}</span>
    </div>
  )}
</a>
