---
/**
 * Lazy container for a canvas demo.
 *
 * Pattern worth copying for every future demo:
 *   - Nothing runs until the frame scrolls into view (IntersectionObserver).
 *   - The renderer arrives via dynamic import(), so its code is a separate chunk that
 *     pages without a demo never download.
 *   - Paused when scrolled away or when the tab is hidden, so a background tab isn't
 *     spinning the GPU.
 *   - `prefers-reduced-motion` means render one static frame and never animate.
 *   - No WebGL2, or a shader that fails to compile, leaves the poster image in place.
 *
 * NOTE: `client:visible` is not used here — Astro's client directives apply to framework
 * components (React/Svelte/…), not .astro files. A custom element plus dynamic import
 * gets the same laziness with no framework dependency.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Shown until the demo takes over, and to anyone who can't run it. */
  poster?: ImageMetadata;
  posterAlt?: string;
  /** CSS aspect-ratio for the frame. */
  aspect?: string;
  /** Describes the visual for screen readers, which get no value from the canvas. */
  label: string;
}

const { poster, posterAlt, aspect = '16 / 9', label } = Astro.props;
---

<figure class="not-prose my-8">
  <shader-demo
    class="relative block overflow-hidden rounded-xl border border-border bg-surface-raised"
    style={`aspect-ratio: ${aspect};`}
  >
    {poster && (
        <Image
          src={poster}
          alt={posterAlt ?? ''}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
      )}

    <canvas
      data-demo-canvas
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-500"
      role="img"
      aria-label={label}
    ></canvas>

    <button
      type="button"
      data-demo-toggle
      hidden
      aria-pressed="false"
      class="absolute bottom-3 right-3 z-10 rounded-md border border-white/20 bg-black/50 px-3 py-1.5 text-xs font-medium text-white backdrop-blur-sm transition-colors hover:bg-black/70"
    >
      Play
    </button>

    <noscript>
      <p
        class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-ink-muted"
      >
        This demo needs JavaScript. The still above shows the result.
      </p>
    </noscript>
  </shader-demo>

  <figcaption class="mt-3 text-sm text-ink-subtle">
    <slot />
  </figcaption>
</figure>

<script>
import type { DemoHandle } from './shaderRenderer';

class ShaderDemo extends HTMLElement {
  #handle: DemoHandle | null = null;
  #observer: IntersectionObserver | null = null;
  #loading = false;
  /** True when the visitor pressed pause — stops scroll from resuming playback. */
  #userPaused = false;

  connectedCallback(): void {
    const canvas = this.querySelector<HTMLCanvasElement>('[data-demo-canvas]');
    if (!canvas) return;

    this.#observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            void this.#activate(canvas);
          } else {
            this.#handle?.pause();
          }
        }
      },
      // Start slightly before the frame is on screen so it's ready by the time it is.
      { rootMargin: '200px 0px' },
    );
    this.#observer.observe(this);

    document.addEventListener('visibilitychange', this.#onVisibilityChange);
  }

  disconnectedCallback(): void {
    this.#observer?.disconnect();
    document.removeEventListener('visibilitychange', this.#onVisibilityChange);
    this.#handle?.destroy();
    this.#handle = null;
  }

  #onVisibilityChange = (): void => {
    if (document.hidden) {
      this.#handle?.pause();
    } else if (!this.#userPaused && this.#isOnScreen()) {
      this.#handle?.play();
    }
  };

  #isOnScreen(): boolean {
    const rect = this.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  }

  async #activate(canvas: HTMLCanvasElement): Promise<void> {
    if (this.#handle) {
      if (!this.#userPaused) this.#handle.play();
      return;
    }
    if (this.#loading) return;
    this.#loading = true;

    // Separate chunk: only fetched once a demo is actually about to be seen.
    const { createShaderDemo } = await import('./shaderRenderer');
    const handle = createShaderDemo(canvas);

    if (!handle) {
      // No WebGL2 (or a compile failure) — leave the poster showing.
      this.#loading = false;
      return;
    }

    this.#handle = handle;
    this.#loading = false;

    // Fade the canvas in on top of the poster. The context is created with alpha:false,
    // so it fully covers the image — hiding the poster as well would flash the
    // background mid-transition, and keeping it costs nothing.
    canvas.classList.remove('opacity-0');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    this.#setupToggle(handle, reduceMotion);

    // Reduced motion: the single frame drawn at creation stands in for the animation.
    if (!reduceMotion) handle.play();
  }

  #setupToggle(handle: DemoHandle, reduceMotion: boolean): void {
    const toggle = this.querySelector<HTMLButtonElement>('[data-demo-toggle]');
    if (!toggle) return;

    // Only useful once there is something to toggle.
    toggle.hidden = false;
    this.#userPaused = reduceMotion;

    const sync = (): void => {
      toggle.textContent = handle.running ? 'Pause' : 'Play';
      toggle.setAttribute('aria-pressed', String(handle.running));
    };

    toggle.addEventListener('click', () => {
      if (handle.running) {
        handle.pause();
        this.#userPaused = true;
      } else {
        handle.play();
        this.#userPaused = false;
      }
      sync();
    });

    sync();
  }
}

// Guard against double registration during dev HMR.
if (!customElements.get('shader-demo')) {
  customElements.define('shader-demo', ShaderDemo);
}
</script>
