---
/** Standard page shell: a title block plus a centred container. */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** Short line under the page title. Falls back to nothing rather than repeating meta. */
  lede?: string;
  noindex?: boolean;
}

const { title, description, lede, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1>
      {lede && <p class="mt-3 max-w-prose text-lg text-ink-muted">{lede}</p>}
    </header>

    <slot />
  </div>
</BaseLayout>
