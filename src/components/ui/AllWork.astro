---
import { getProjects } from '../../lib/content';
import ProjectShowCardSet from './ProjectShowCardSet.astro';
import SectionHeader from './SectionHeader.astro';
import SquareCard from './SquareCard.astro';

const allProjects = await getProjects();

/** Palette colours cycled across placeholder cards. Uses CSS vars from the palette layer
 *  so no hex literals land in markup. */
const PLACEHOLDER_FILLS = [
  'var(--aqua-200)',
  'var(--salmon-200)',
  'var(--ink-800)',
  'var(--aqua-600)',
  'var(--shell-100)',
  'var(--salmon-600)',
  'var(--aqua-700)',
  'var(--shell-200)',
] as const;
---

{allProjects.length > 0 ? (
  <section class="pt-24 pb-36">
    <SectionHeader title="My Work" subtitle="Take a scroll, stay a while" />

    <ul class="mt-28 grid grid-cols-1 gap-x-12 gap-y-36 px-6 sm:grid-cols-2 sm:px-8 lg:px-12" aria-label="All projects">
      {allProjects.slice(0, 6).map((project, i) => (
        <li class="work-reveal" style={`--reveal-i: ${i}`}>
          <SquareCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            cover={project.data.cover}
            coverAlt={project.data.coverAlt}
            fill={PLACEHOLDER_FILLS[i % PLACEHOLDER_FILLS.length]}
            showProject={project.id}
          />
        </li>
      ))}
    </ul>
  </section>
) : (
  <section class="py-24">
    <SectionHeader title="Work" subtitle="Nothing published yet." />
  </section>
)}

<ProjectShowCardSet />

<script>
function initWorkReveal() {
  const items = document.querySelectorAll<HTMLElement>('.work-reveal');
  if (!items.length) return;

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 },
  );

  for (const item of items) observer.observe(item);
}

initWorkReveal();
document.addEventListener('astro:after-swap', initWorkReveal);
</script>
