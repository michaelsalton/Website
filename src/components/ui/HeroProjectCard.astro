---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  projectId: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  class?: string;
  style?: string;
}

const { href, projectId, cover, coverAlt, class: className, style } = Astro.props;
---

<a
  href={href}
  data-show-project={projectId}
  class:list={['hero-card overflow-hidden', className]}
  style={style}
>
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? ''}
      class="h-full w-full object-cover"
      inferSize
    />
  ) : (
    <div class="h-full w-full bg-surface-sunken"></div>
  )}
</a>
