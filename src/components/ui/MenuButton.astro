---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'button'>, 'type'>;

const { class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md px-3 py-2.5 text-micro uppercase text-content-subtle transition-colors duration-(--duration-fast) hover:text-content',
    className,
  ]}
  {...rest}
>
  <svg
    class="h-4 w-4"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="4" y1="6" x2="20" y2="6"></line>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <line x1="4" y1="18" x2="20" y2="18"></line>
  </svg>
  Menu
</button>
