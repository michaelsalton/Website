{
  // Biome is the single formatter — Prettier/ESLint are deliberately not installed.
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[astro]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // Tailwind v4 config lives in CSS, so point IntelliSense at the stylesheet and stop
  // the built-in CSS linter flagging @theme / @plugin / @custom-variant as unknown.
  "tailwindCSS.experimental.configFile": "src/styles/global.css",
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.includeLanguages": {
    "astro": "html"
  },

  "files.associations": {
    "*.css": "tailwindcss"
  },
  "search.exclude": {
    "**/dist": true,
    "**/.astro": true,
    "**/.vercel": true
  }
}
