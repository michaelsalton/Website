---
import HeroNameTag from '../ui/HeroNameTag.astro';

interface Props {
  /** When true the header starts transparent over the hero and solidifies on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header
  class="fixed top-0 right-0 left-0 z-50 font-display bg-transparent transition-[color,background-color,border-color,backdrop-filter,transform] duration-(--duration-base) ease-(--ease-out-soft)"
  {...overlay ? { 'data-hero-overlay': 'true' } : {}}
>
  <div class="grid grid-cols-3 items-start px-6 pt-4 sm:px-10">
    <div></div>
    <HeroNameTag class="justify-self-center" />
    <div></div>
  </div>
</header>

<script>
function initHeader() {
  const header = document.querySelector<HTMLElement>('header');

  // Scroll-aware overlay: solidify the header after scrolling past 64px.
  const hasOverlay = header?.hasAttribute('data-hero-overlay');
  if (hasOverlay && header) {
    const updateOverlay = () => {
      if (window.scrollY > 64) {
        header.removeAttribute('data-hero-overlay');
      } else {
        header.setAttribute('data-hero-overlay', 'true');
      }
    };
    window.addEventListener('scroll', updateOverlay, { passive: true });
    updateOverlay();
  }
}

// Run on initial load and after Astro client-side navigations.
initHeader();
document.addEventListener('astro:after-swap', initHeader);
</script>
