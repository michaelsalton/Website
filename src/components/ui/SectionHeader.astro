---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
  <h2 class="text-h1 text-content uppercase">{title}</h2>
  {subtitle && <p class="mt-3 text-body-sm text-content-muted">{subtitle}</p>}
</div>
