---
/**
 * The only place <html>, <head> and <body> are written. Every other layout and page
 * composes through this one so the head, header, footer and skip link stay consistent.
 */
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SmoothScroll from '../components/layout/SmoothScroll.astro';
import BaseHead from '../components/seo/BaseHead.astro';
import HoverSound from '../components/ui/HoverSound.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Enables transparent header overlay mode for the hero section. */
  heroMode?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead {...props} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only-focusable absolute left-4 top-4 z-100 rounded-md bg-accent px-4 py-2 text-on-accent"
    >
      Skip to content
    </a>

    <SmoothScroll />
    <HoverSound />
    <Header overlay={props.heroMode} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Page-load curtain: covers the viewport and lifts to reveal content. -->
    <div class="page-curtain" aria-hidden="true"></div>
  </body>
</html>
