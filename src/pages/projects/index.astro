---
import Card from '../../components/ui/Card.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<PageLayout
  title="Work"
  description="Selected engineering work — renderers, graphics, and web."
  lede="Things I've built, and what I learned building them."
>
  {projects.length === 0 ? (
      <p class="text-content-muted">Nothing published yet.</p>
    ) : (
      <CardGrid label="Work">
        {projects.map((project) => (
          <li>
            <Card
              href={project.data.link ?? `/${project.id}`}
              title={project.data.title}
              description={project.data.summary}
              meta={`${project.data.year} · ${project.data.role}`}
              tags={project.data.stack}
              {...(project.data.link ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            />
          </li>
        ))}
      </CardGrid>
    )}
</PageLayout>
