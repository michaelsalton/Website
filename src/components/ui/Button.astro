---
import type { HTMLAttributes } from 'astro/types';

/**
 * Renders an <a> when given `href`, otherwise a <button> — so a link never gets
 * button semantics or vice versa.
 *
 * `href` and `type` are declared explicitly and omitted from the inherited attributes:
 * <a type> is a MIME type while <button type> is an enum, so leaving both in the union
 * widens `type` to plain `string` and stops it being assignable to the button.
 */
type Props = {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'href' | 'type'>;

const { variant = 'primary', href, type = 'button', class: className, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-(--duration-fast)';

const variants = {
  primary: 'bg-accent text-accent-ink hover:opacity-90',
  secondary: 'border border-border text-ink hover:border-accent hover:text-accent',
} as const;

const classes = [base, variants[variant], className];
---

{href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )}
