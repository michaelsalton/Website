---
import { NAV, SITE } from '../../consts';

// Mark the active section so the nav reflects where you are. Compares the first path
// segment so /blog/some-post still highlights "Writing".
const section = `/${Astro.url.pathname.split('/').filter(Boolean)[0] ?? ''}`;
---

<header class="sticky top-0 z-50 border-b border-border bg-canvas/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="font-semibold tracking-tight text-ink transition-colors hover:text-accent">
      {SITE.title}
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-1 text-sm sm:gap-2">
        {NAV.map((item) => {
            const isActive = section === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'rounded-md px-2 py-1.5 transition-colors sm:px-3',
                    isActive
                      ? 'bg-surface-raised font-medium text-ink'
                      : 'text-ink-muted hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
      </ul>
    </nav>
  </div>
</header>
