---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Button from '../../components/ui/Button.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getProjects } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, stack, year, cover, coverAlt, repo, live } = project.data;
---

<ArticleLayout title={title} description={summary} eyebrow="Project" tags={stack}>
  {cover && (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        class="not-prose mb-8 w-full rounded-xl border border-line"
        widths={[480, 768, 1024]}
        sizes="(max-width: 768px) 100vw, 768px"
      />
    )}

  <dl class="not-prose mb-10 grid grid-cols-2 gap-4 border-y border-line py-5 text-caption">
    <div>
      <dt class="text-content-subtle">Role</dt>
      <dd class="mt-1 text-content">{role}</dd>
    </div>
    <div>
      <dt class="text-content-subtle">Year</dt>
      <dd class="mt-1 text-content">{year}</dd>
    </div>
    {(repo || live) && (
        <div class="col-span-2 flex gap-4">
          {repo && (
            <Button href={repo} variant="underline" rel="noopener" target="_blank">
              Source
            </Button>
          )}
          {live && (
            <Button href={live} variant="underline" rel="noopener" target="_blank">
              Live
            </Button>
          )}
        </div>
      )}
  </dl>

  <Content />
</ArticleLayout>
